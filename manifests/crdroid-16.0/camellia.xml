<?xml version="1.0" encoding="UTF-8"?>
<!-- Local manifest for crDroid 12 (branch 16.0, based on LineageOS 23.2) on camellia.
     Copied to .repo/local_manifests/ by scripts/04-sync.sh and scripts/update.sh. -->
<manifest>
  <!-- Device tree, kernel and kernel modules (cristidclxvi) -->
  <project name="cristidclxvi/android_device_xiaomi_camellia"
           path="device/xiaomi/camellia" remote="github" revision="lineage-23.2" />
  <project name="cristidclxvi/android_kernel_xiaomi_camellia"
           path="kernel/xiaomi/camellia" remote="github" revision="lineage-23.2" />
  <project name="cristidclxvi/android_kernel_modules_xiaomi_camellia"
           path="kernel/xiaomi/vendor" remote="github" revision="lineage-23.2" />

  <!-- Common MediaTek / Xiaomi parts from LineageOS -->
  <project name="LineageOS/android_device_mediatek_sepolicy_vndr"
           path="device/mediatek/sepolicy_vndr" remote="github" />
  <project name="LineageOS/android_hardware_mediatek"
           path="hardware/mediatek" remote="github" />
  <project name="LineageOS/android_hardware_xiaomi"
           path="hardware/xiaomi" remote="github" />

  <!-- MediaTek IMS (VoLTE), pinned on purpose -->
  <project name="cristidclxvi/android_vendor_mediatek_ims"
           path="vendor/mediatek/ims" remote="github"
           revision="32a265afc6a297b20e8c8a4c870133de0e188884" />

  <!-- Kernel toolchain clang r383902 (only available on AOSP android-12 branches) -->
  <project name="platform/prebuilts/clang/host/linux-x86"
           path="prebuilts/clang/host/linux-x86-r383902"
           remote="aosp" revision="refs/tags/android-12.1.0_r27"
           clone-depth="1" />

  <!-- Until crDroid 12.13 this file replaced 9 projects (CellBroadcastService, Telephony, Iwlan,
       NeuralNetworks, keymint, aac, tremolo, hplip, broadcom wlan) with the LineageOS forks, because
       crDroid still used the plain AOSP versions. Since crDroid 12.14 (2026-11-18) crDroid's own
       manifest uses those LineageOS forks, so the replacements were dropped. If it is ever needed
       again: a remove-project element (by path, optional=true) plus a project element with the fork. -->

  <!-- ViPER4AndroidFX (audio effects). Included by patches/device/0003-*, can be disabled
       with WITH_VIPER=false in config.env (the project is then synced but not built). -->
  <project name="TogoFire/packages_apps_ViPER4AndroidFX"
           path="packages/apps/ViPER4AndroidFX" remote="github" revision="v4a" />
</manifest>
