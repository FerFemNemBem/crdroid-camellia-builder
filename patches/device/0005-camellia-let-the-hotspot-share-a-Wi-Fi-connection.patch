From f3a4e49f3f773413c5e9cc561728759d13ddcffa Mon Sep 17 00:00:00 2001
From: Fieldmar <974888+fieldmar@users.noreply.github.com>
Date: Tue, 17 Nov 2026 10:53:26 +0000
Subject: [PATCH] camellia: let the hotspot share a Wi-Fi connection (STA + AP)

Advertise a single chip mode with STA + AP instead of the default
either/or modes, so turning the hotspot on no longer turns Wi-Fi off
and the phone can act as a repeater.

In that single mode the HAL never calls changeFirmwareMode, so the
"STA"/"AP" writes to /dev/wmtWifi that also powered the chip on stop
happening and wlan0 is never created. Power the chip through the
driver-state path instead.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
Change-Id: I9cf22f097602e5bfc2ecc72093fee04678fd9067
---
 BoardConfig.mk | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 81390cc..b640bbc 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -192,6 +192,19 @@ BOARD_WPA_SUPPLICANT_DRIVER := NL80211
 WIFI_DRIVER_FW_PATH_PARAM := "/dev/wmtWifi"
 WIFI_DRIVER_FW_PATH_STA := "STA"
 WIFI_DRIVER_FW_PATH_AP := "AP"
+# Advertise one chip mode with STA + AP (and STA + P2P) instead of the
+# default either/or STA and AP modes, so the hotspot can share a Wi-Fi
+# connection ("repeater") rather than switching Wi-Fi off. The AP interface
+# (ro.vendor.wifi.sap.interface) is then created through the vendor
+# libwifi-hal's wifi_virtual_interface_create while wlan0 stays up.
+WIFI_HIDL_FEATURE_DUAL_INTERFACE := true
+# In that single mode the HAL never calls changeFirmwareMode, so the
+# "STA"/"AP" writes above (which also powered the chip on) no longer happen
+# and wlan0 is never created. Power the chip through the driver-state path
+# instead: libwifi-hal writes "1" on load and "0" on unload.
+WIFI_DRIVER_STATE_CTRL_PARAM := "/dev/wmtWifi"
+WIFI_DRIVER_STATE_ON := "1"
+WIFI_DRIVER_STATE_OFF := "0"
 
 # Inherit vendor blob makefile (generated by extract-files.py)
 include vendor/xiaomi/camellia/BoardConfigVendor.mk
