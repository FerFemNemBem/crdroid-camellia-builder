+ namespace /* unnamed */ {
+ 
++// camellia: the MediaTek Codec2 HAL on this device is an Android 12 vendor
++// blob that never closes the release fence it gets back from dequeueBuffer().
++// The Android 16 display path returns a real release fence for every frame,
++// so the HAL leaks one sync_file fd per frame until it reaches its open-file
++// limit (32768, about 18 minutes of 30 fps video) and aborts, killing every
++// decoder in use. Wait for the fence on this side instead and hand the HAL a
++// buffer with no fence, so there is nothing for it to leak. If the fence does
++// not signal in time, pass it through unchanged. Waits of 8 ms or more are
++// logged so the cost can be checked.
++class FenceWaitingB2HGraphicBufferProducer : public HGraphicBufferProducer2 {
++    // Forwards to a plain B2HGraphicBufferProducer. Composition, not
++    // inheritance: B2HGraphicBufferProducer holds an sp<Obituary> whose type
++    // is private to libgui, so a subclass cannot be destroyed from here.
++    using HStatus = ::android::hardware::graphics::bufferqueue::V2_0::Status;
++    using HConnectionType = ::android::hardware::graphics::bufferqueue::V2_0::ConnectionType;
++    using HProducerListener = ::android::hardware::graphics::bufferqueue::V2_0::IProducerListener;
++    using HHardwareBuffer = ::android::hardware::graphics::common::V1_2::HardwareBuffer;
++    using hidl_handle = ::android::hardware::hidl_handle;
++
++    sp<HGraphicBufferProducer2> mInner;
++
++public:
++    explicit FenceWaitingB2HGraphicBufferProducer(sp<::android::IGraphicBufferProducer> const& base)
++        : mInner(new B2HGraphicBufferProducer2(base)) {}
++
++    Return<void> dequeueBuffer(DequeueBufferInput const& input,
++                               dequeueBuffer_cb _hidl_cb) override {
++        return mInner->dequeueBuffer(
++                input,
++                [&_hidl_cb](HStatus status, int32_t slot, DequeueBufferOutput const& output) {
++                    native_handle_t const* h = output.fence.getNativeHandle();
++                    if (h && h->numFds == 1 && h->numInts == 0 && h->data[0] >= 0) {
++                        sp<Fence> fence = new Fence(dup(h->data[0]));
++                        nsecs_t start = systemTime();
++                        status_t waited = fence->wait(1000);
++                        nsecs_t ms = (systemTime() - start) / 1000000;
++                        if (ms >= 8) {
++                            ALOGD("dequeueBuffer: waited %lld ms for the release fence",
++                                  (long long)ms);
++                        }
++                        if (waited == OK) {
++                            DequeueBufferOutput noFence{};
++                            noFence.bufferAge = output.bufferAge;
++                            noFence.bufferNeedsReallocation = output.bufferNeedsReallocation;
++                            noFence.releaseAllBuffers = output.releaseAllBuffers;
++                            _hidl_cb(status, slot, noFence);
++                            return;
++                        }
++                    }
++                    _hidl_cb(status, slot, output);
++                });
++    }
++
++    Return<HStatus> setMaxDequeuedBufferCount(int32_t n) override {
++        return mInner->setMaxDequeuedBufferCount(n);
++    }
++    Return<void> requestBuffer(int32_t slot, requestBuffer_cb cb) override {
++        return mInner->requestBuffer(slot, cb);
++    }
++    Return<HStatus> setAsyncMode(bool async) override { return mInner->setAsyncMode(async); }
++    Return<HStatus> detachBuffer(int32_t slot) override { return mInner->detachBuffer(slot); }
++    Return<void> detachNextBuffer(detachNextBuffer_cb cb) override {
++        return mInner->detachNextBuffer(cb);
++    }
++    Return<void> attachBuffer(HHardwareBuffer const& buffer, uint32_t generationNumber,
++                              attachBuffer_cb cb) override {
++        return mInner->attachBuffer(buffer, generationNumber, cb);
++    }
++    Return<void> queueBuffer(int32_t slot, QueueBufferInput const& input,
++                             queueBuffer_cb cb) override {
++        return mInner->queueBuffer(slot, input, cb);
++    }
++    Return<HStatus> cancelBuffer(int32_t slot, hidl_handle const& fence) override {
++        return mInner->cancelBuffer(slot, fence);
++    }
++    Return<void> query(int32_t what, query_cb cb) override { return mInner->query(what, cb); }
++    Return<void> connect(sp<HProducerListener> const& listener, HConnectionType api,
++                         bool producerControlledByApp, connect_cb cb) override {
++        return mInner->connect(listener, api, producerControlledByApp, cb);
++    }
++    Return<HStatus> disconnect(HConnectionType api) override { return mInner->disconnect(api); }
++    Return<HStatus> allocateBuffers(uint32_t width, uint32_t height, uint32_t format,
++                                    uint64_t usage) override {
++        return mInner->allocateBuffers(width, height, format, usage);
++    }
++    Return<HStatus> allowAllocation(bool allow) override {
++        return mInner->allowAllocation(allow);
++    }
++    Return<HStatus> setGenerationNumber(uint32_t generationNumber) override {
++        return mInner->setGenerationNumber(generationNumber);
++    }
++    Return<HStatus> setDequeueTimeout(int64_t timeoutNs) override {
++        return mInner->setDequeueTimeout(timeoutNs);
++    }
++    Return<uint64_t> getUniqueId() override { return mInner->getUniqueId(); }
++    Return<void> getConsumerName(getConsumerName_cb cb) override {
++        return mInner->getConsumerName(cb);
++    }
++};
++
++
+ // c2_status_t value that corresponds to hwbinder transaction failure.
+ constexpr c2_status_t C2_TRANSACTION_FAILED = C2_CORRUPTED;
+ 
+@@ -3632,7 +3734,7 @@ c2_status_t Codec2Client::Component::setOutputSurface(
+     sp<HGraphicBufferProducer2> igbp = surface ?
+             surface->getHalInterface<HGraphicBufferProducer2>() : nullHgbp;
+     if (surface && !igbp) {
+-        igbp = new B2HGraphicBufferProducer2(surface);
++        igbp = new FenceWaitingB2HGraphicBufferProducer(surface);
+     }
+ 
+     std::scoped_lock lock(mOutputMutex);
