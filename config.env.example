# crdroid-camellia-builder configuration
#
# Copy this file to "config.env" in the same folder and adjust it:
#     cp config.env.example config.env
# config.env is ignored by git, so your personal values never end up in the repository.
# The file is read by bash: KEY="value", no spaces around "=". $HOME may be used.
# Every value has a sensible default; an empty config.env works.

## ---------------------------------------------------------------- Directories
# Source tree, ccache and signing keys. Needs about 300 GB on a fast disk.
# On WSL this MUST be inside the Linux file system (e.g. $HOME/...), never /mnt/c, /mnt/d, ...
WORK_DIR="$HOME/android"

# Finished builds, downloads, logs and key backups (about 10 GB plus 1.3 GB per build).
# On WSL a Windows drive is fine here and convenient, e.g. "/mnt/d/crdroid" (= D:\crdroid).
OUTPUT_DIR="$HOME/crdroid-out"

## ---------------------------------------------------------------------- Build
# Parallel compile jobs. Empty = number of CPU threads.
JOBS=""
# Parallel downloads during "repo sync". More than 6-8 often triggers "429 Too Many Requests".
SYNC_JOBS=6
# Size of the compiler cache (speeds up later builds a lot).
CCACHE_SIZE="50G"
# Warn (and ask) if less RAM than this is available. 32 GB works, 64 GB is comfortable.
MIN_RAM_GB=30

## ------------------------------------------------------------------- Features
# ViPER4AndroidFX audio effects app (TogoFire). true/false
WITH_VIPER=true
# Download MindTheGapps (Google apps) next to the build so you can flash them. true/false
# They are never built into the ROM; flashing them is optional.
WITH_GAPPS=false

## -------------------------------------------------------------------- Signing
# own  = your own release keys (recommended, see docs/signing.md)
# test = public AOSP test keys (only for trying things out; insecure)
SIGNING="own"
# Certificate subject for your own keys. Empty = you are asked once.
# Example: "/C=DE/O=Example/OU=crDroid builds/CN=camellia release"
KEY_SUBJECT=""

## -------------------------------------------------------- OTA server (optional)
# Leave OTA_URL empty to keep the stock crDroid updater (no OTA from your own server).
# Must end with "/{device}.json". https:// is recommended; http:// is allowed for exactly
# this one host (update packages are still verified with your release key).
# Example: OTA_URL="https://ota.example.org/crdroid/{device}.json"
OTA_URL=""
# rsync target for the folder that OTA_URL points to (see docs/ota-server.md).
# Example: OTA_UPLOAD="ota-server:crdroid"   (an ~/.ssh/config host)
OTA_UPLOAD=""
# Number of builds kept on the server.
OTA_KEEP=3
# Shown in the updater as "<version> by <MAINTAINER>". Empty = no name is shown.
MAINTAINER=""

## --------------------------------------------------------------------- Windows
# Name of the WSL distribution used by scripts/windows/*.ps1
WSL_DISTRO="crdroid"
